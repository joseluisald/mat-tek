---
import type { Brand } from '../types';

interface Props {
  brand: Brand;
  className?: string;
  size?: 'sm' | 'md' | 'lg';
}

const { brand, className = '', size = 'md' } = Astro.props;

const sizeClasses = {
  sm: 'h-8 px-2 text-xs',
  md: 'h-12 sm:h-14 px-3 sm:px-4 text-sm',
  lg: 'h-16 px-5 text-base',
}[size];
---

<div class={`flex items-center justify-center ${sizeClasses} ${className}`}>
  <img
    src={brand.logoUrl}
    alt={`Logo ${brand.name}`}
    loading="lazy"
    decoding="async"
    class="max-h-full max-w-full object-contain filter contrast-105 transition-transform duration-300 group-hover:scale-105"
  />
</div>
