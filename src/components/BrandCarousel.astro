---
import { AUTHORIZED_BRANDS } from '../data/brands';
import BrandLogo from './BrandLogo.astro';
import Icon from './Icon.astro';

interface Props {
  title?: string;
  subtitle?: string;
}

const {
  title = "Marcas com Assistência Autorizada",
  subtitle = "Garantia oficial de fábrica e peças 100% originais para os principais fabricantes mundiais"
} = Astro.props;

// Duplicate brands array for smooth infinite marquee
const marqueeItems = [...AUTHORIZED_BRANDS, ...AUTHORIZED_BRANDS];

const categories = [
  { id: 'all', label: 'Todas as Marcas (12)' },
  { id: 'florestal', label: 'Florestal & Jardim' },
  { id: 'forca', label: 'Força & Energia' },
  { id: 'limpeza', label: 'Limpeza & Lavadoras' },
  { id: 'oficina', label: 'Oficina & Solda' },
];

const brandsJson = JSON.stringify(AUTHORIZED_BRANDS);
---

<div 
  x-data={`{ 
    paused: false,
    selectedBrand: null,
    activeTab: 'all',
    searchTerm: '',
    viewMode: 'marquee',
    brands: ${brandsJson},

    get filteredBrands() {
      return this.brands.filter(b => {
        const matchesSearch = !this.searchTerm || 
          b.name.toLowerCase().includes(this.searchTerm.toLowerCase()) ||
          b.specialty.toLowerCase().includes(this.searchTerm.toLowerCase()) ||
          b.popularItems.some(i => i.toLowerCase().includes(this.searchTerm.toLowerCase()));

        if (!matchesSearch) return false;
        if (this.activeTab === 'all') return true;

        if (this.activeTab === 'florestal') {
          return ['husqvarna', 'tekna', 'toyama', 'vulcan-trent', 'oregon', 'kawashima'].includes(b.id);
        }
        if (this.activeTab === 'forca') {
          return ['branco', 'toyama', 'gotze', 'kawashima', 'tekna'].includes(b.id);
        }
        if (this.activeTab === 'limpeza') {
          return ['jacto-clean', 'tekna', 'vulcan-trent'].includes(b.id);
        }
        if (this.activeTab === 'oficina') {
          return ['lynus', 'gmeg', 'tramontina', 'oregon'].includes(b.id);
        }
        return true;
      });
    },

    openBrandModal(brand) {
      this.selectedBrand = brand;
    },
    closeBrandModal() {
      this.selectedBrand = null;
    }
  }`}
  class="relative w-full py-12 md:py-16 bg-[#12151A] text-white overflow-hidden border-y border-neutral-800"
>
  <!-- Background visual texture -->
  <div 
    class="absolute inset-0 opacity-5 pointer-events-none"
    style="background-image: radial-gradient(#ffffff 1px, transparent 1px); background-size: 24px 24px;"
  ></div>

  <!-- Header Section -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 mb-8">
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-6">
      <div class="space-y-2 max-w-2xl">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-red-500/10 border border-red-500/20 text-[#E31B23] text-xs font-bold uppercase tracking-wider">
          <Icon name="shieldCheck" class="w-3.5 h-3.5" />
          <span>Assistência Técnica Autorizada</span>
        </div>
        <h2 class="text-2xl sm:text-3xl lg:text-4xl font-black tracking-tight text-white">
          {title}
        </h2>
        <p class="text-sm sm:text-base text-slate-400">
          {subtitle}
        </p>
      </div>

      <!-- Controls: Toggle Marquee vs Search Grid -->
      <div class="flex flex-wrap items-center gap-2">
        <button
          type="button"
          @click="viewMode = 'marquee'"
          :class="viewMode === 'marquee' ? 'bg-[#E31B23] text-white' : 'bg-neutral-800 text-slate-300 hover:bg-neutral-700'"
          class="px-3.5 py-2 rounded-xl text-xs font-semibold transition-all cursor-pointer flex items-center gap-1.5"
        >
          <Icon name="refreshCw" class="w-3.5 h-3.5" />
          <span>Carrossel</span>
        </button>

        <button
          type="button"
          @click="viewMode = 'grid'"
          :class="viewMode === 'grid' ? 'bg-[#E31B23] text-white' : 'bg-neutral-800 text-slate-300 hover:bg-neutral-700'"
          class="px-3.5 py-2 rounded-xl text-xs font-semibold transition-all cursor-pointer flex items-center gap-1.5"
        >
          <Icon name="filter" class="w-3.5 h-3.5" />
          <span>Ver Catálogo Completo</span>
        </button>
      </div>
    </div>

    <!-- Category Filter Bar (Visible in Grid mode) -->
    <div x-show="viewMode === 'grid'" x-cloak class="mt-6 pt-6 border-t border-neutral-800 flex flex-col sm:flex-row items-stretch sm:items-center justify-between gap-4">
      <div class="flex flex-wrap gap-2">
        {categories.map((cat) => (
          <button
            type="button"
            @click={`activeTab = '${cat.id}'`}
            :class={`activeTab === '${cat.id}' ? 'bg-white text-slate-950 font-bold' : 'bg-neutral-800/80 text-slate-300 hover:bg-neutral-700'`}
            class="px-3 py-1.5 rounded-lg text-xs transition-all cursor-pointer"
          >
            {cat.label}
          </button>
        ))}
      </div>

      <!-- Search Input -->
      <div class="relative min-w-[220px]">
        <Icon name="search" class="w-4 h-4 text-slate-400 absolute left-3 top-1/2 -translate-y-1/2" />
        <input
          type="text"
          x-model="searchTerm"
          placeholder="Buscar marca ou peça..."
          class="w-full pl-9 pr-3 py-1.5 bg-neutral-900 border border-neutral-700 rounded-lg text-xs text-white placeholder-slate-400 focus:outline-none focus:border-[#E31B23]"
        />
      </div>
    </div>
  </div>

  <!-- MODE 1: Horizontal Continuous Infinite Marquee Track (overflow hidden, NO scrollbar) -->
  <div 
    x-show="viewMode === 'marquee'"
    class="relative w-full overflow-hidden py-3 select-none"
    @mouseenter="paused = true"
    @mouseleave="paused = false"
    @touchstart="paused = true"
    @touchend="paused = false"
  >
    <!-- Soft edge gradient fades for desktop -->
    <div class="hidden md:block absolute left-0 top-0 bottom-0 w-24 bg-gradient-to-r from-[#12151A] to-transparent z-10 pointer-events-none"></div>
    <div class="hidden md:block absolute right-0 top-0 bottom-0 w-24 bg-gradient-to-l from-[#12151A] to-transparent z-10 pointer-events-none"></div>

    <!-- Moving track -->
    <div 
      class="animate-marquee-infinite flex items-center gap-4 sm:gap-6 px-4"
      :class="{ 'paused': paused }"
    >
      {marqueeItems.map((brand, index) => (
        <button
          type="button"
          @click={`openBrandModal(${JSON.stringify(brand)})`}
          class="group relative w-48 sm:w-56 h-22 sm:h-24 shrink-0 bg-[#191E25] hover:bg-[#202732] border border-neutral-800 hover:border-[#E31B23]/70 rounded-xl p-3 flex items-center justify-center transition-all duration-200 shadow-sm hover:shadow-md hover:-translate-y-0.5 cursor-pointer text-left"
          title={`Ver detalhes autorizados da marca ${brand.name}`}
        >
          <BrandLogo brand={brand} size="md" />
          <span class="absolute top-2 right-2 opacity-0 group-hover:opacity-100 transition-opacity text-[10px] font-mono text-[#E31B23]">
            <Icon name="externalLink" class="w-3 h-3" />
          </span>
        </button>
      ))}
    </div>
  </div>

  <!-- MODE 2: Filtered Grid View -->
  <div x-show="viewMode === 'grid'" x-cloak class="max-w-7xl mx-auto px-4 sm:px-6">
    <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-4">
      <template x-for="brand in filteredBrands" :key="brand.id">
        <div 
          @click="openBrandModal(brand)"
          class="bg-[#191E25] hover:bg-[#202732] border border-neutral-800 hover:border-[#E31B23] rounded-2xl p-4 transition-all duration-200 cursor-pointer flex flex-col justify-between space-y-3 group"
        >
          <div class="h-16 flex items-center justify-center p-2 bg-[#12151A] rounded-xl border border-neutral-800">
            <img :src="brand.logoUrl" :alt="brand.name" class="max-h-full max-w-full object-contain filter contrast-105 group-hover:scale-105 transition-transform" />
          </div>
          <div>
            <div class="flex items-center justify-between">
              <h4 class="font-bold text-sm text-white" x-text="brand.name"></h4>
              <span class="text-[10px] text-emerald-400 font-mono">Autorizada</span>
            </div>
            <p class="text-[11px] text-slate-400 line-clamp-2 mt-1" x-text="brand.specialty"></p>
          </div>
          <div class="pt-2 border-t border-neutral-800 flex items-center justify-between text-[10px] text-slate-400">
            <span>Ver peças e serviços</span>
            <span class="text-[#E31B23] group-hover:translate-x-1 transition-transform">→</span>
          </div>
        </div>
      </template>
    </div>
  </div>

  <!-- Bottom trust note -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 mt-8 flex flex-wrap items-center justify-between gap-4 text-xs text-slate-400">
    <div class="flex items-center gap-2">
      <Icon name="shieldCheck" class="w-4 h-4 text-emerald-400 shrink-0" />
      <span>Atendimento autorizado com diagnósticos certificados e peças genuínas de fábrica em Pelotas e Canguçu.</span>
    </div>
    <span class="text-slate-500 font-mono">12 Marcas Credenciadas</span>
  </div>

  <!-- Brand Details Modal (shadcn Dialog style with Alpine.js) -->
  <div 
    x-cloak 
    x-show="selectedBrand" 
    class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/70 backdrop-blur-sm"
    x-transition:enter="transition ease-out duration-200"
    x-transition:enter-start="opacity-0"
    x-transition:enter-end="opacity-100"
    x-transition:leave="transition ease-in duration-150"
    x-transition:leave-start="opacity-100"
    x-transition:leave-end="opacity-0"
    @keydown.escape.window="closeBrandModal()"
  >
    <div 
      class="relative w-full max-w-lg bg-[#181D24] text-white border border-neutral-700 rounded-2xl p-6 sm:p-7 shadow-2xl space-y-5"
      @click.outside="closeBrandModal()"
      x-transition:enter="transition ease-out duration-200"
      x-transition:enter-start="opacity-0 scale-95"
      x-transition:enter-end="opacity-100 scale-100"
      x-transition:leave="transition ease-in duration-150"
      x-transition:leave-start="opacity-100 scale-100"
      x-transition:leave-end="opacity-0 scale-95"
    >
      <!-- Close Button -->
      <button 
        type="button"
        @click="closeBrandModal()"
        class="absolute top-4 right-4 p-2 text-slate-400 hover:text-white hover:bg-neutral-800 rounded-lg transition-colors cursor-pointer"
        aria-label="Fechar janela"
      >
        <Icon name="x" class="w-5 h-5" />
      </button>

      <!-- Modal Content -->
      <template x-if="selectedBrand">
        <div class="space-y-4">
          <div class="flex items-center gap-4">
            <div class="w-20 h-16 bg-[#222832] rounded-xl border border-neutral-700 p-2 flex items-center justify-center shrink-0">
              <img :src="selectedBrand.logoUrl" :alt="selectedBrand.name" class="max-h-full max-w-full object-contain filter contrast-105" />
            </div>
            <div>
              <div class="flex items-center gap-2">
                <h3 class="text-xl font-black text-white" x-text="selectedBrand.name"></h3>
                <span class="text-[11px] font-bold px-2 py-0.5 rounded-full bg-emerald-950 text-emerald-300 border border-emerald-800">Autorizada</span>
              </div>
              <p class="text-xs text-slate-400 mt-0.5" x-text="selectedBrand.country"></p>
            </div>
          </div>

          <div class="space-y-3 text-xs sm:text-sm text-slate-300">
            <div>
              <strong class="text-slate-200 block text-xs font-semibold uppercase tracking-wider">Especialidade:</strong>
              <p x-text="selectedBrand.specialty" class="mt-0.5"></p>
            </div>

            <div>
              <strong class="text-slate-200 block text-xs font-semibold uppercase tracking-wider">Sobre a Parceria:</strong>
              <p x-text="selectedBrand.description" class="mt-0.5 text-slate-300 leading-relaxed"></p>
            </div>

            <div>
              <strong class="text-slate-200 block text-xs font-semibold uppercase tracking-wider">Itens e Equipamentos Frequentes:</strong>
              <div class="flex flex-wrap gap-1.5 mt-1.5">
                <template x-for="item in selectedBrand.popularItems" :key="item">
                  <span class="inline-flex items-center px-2.5 py-1 rounded-lg text-xs font-medium bg-neutral-800 text-slate-200 border border-neutral-700" x-text="item"></span>
                </template>
              </div>
            </div>
          </div>

          <!-- Actions -->
          <div class="pt-4 border-t border-neutral-800 flex flex-col sm:flex-row items-center gap-3">
            <a
              :href="`https://wa.me/5553984489179?text=${encodeURIComponent('Olá Mat-Tek! Gostaria de peças e assistência para equipamentos da marca: ' + selectedBrand.name)}`"
              target="_blank"
              rel="noreferrer"
              class="w-full inline-flex items-center justify-center gap-2 px-5 py-3 rounded-xl bg-emerald-600 hover:bg-emerald-700 text-white font-bold text-xs transition-all active:scale-95 shadow-md text-center"
            >
              <Icon name="messageCircle" class="w-4 h-4" />
              <span>Solicitar Peças / Revisão desta Marca</span>
            </a>
          </div>
        </div>
      </template>
    </div>
  </div>
</div>
