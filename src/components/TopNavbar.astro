---
import { COMPANY_INFO, isStoreOpenNow } from '../data/stores';
import Icon from './Icon.astro';

const storeStatus = isStoreOpenNow();

const navLinks = [
  { id: 'inicio', label: 'Início' },
  { id: 'parceiros', label: 'Marcas' },
  { id: 'servicos', label: 'Serviços' },
  { id: 'historia', label: 'Nossa História' },
  { id: 'unidades', label: 'Lojas & Horários' },
  { id: 'contato', label: 'Contato' },
];
---

<div x-data="{ mobileMenuOpen: false }">
  <!-- Top Utility Bar with store hours & locations -->
  <div class="bg-[#15181C] text-slate-300 text-xs py-1.5 px-4 sm:px-6 border-b border-neutral-800">
    <div class="max-w-7xl mx-auto flex flex-wrap items-center justify-between gap-2">
      <div class="flex items-center gap-4 text-slate-300">
        <span class="flex items-center gap-1.5 font-medium">
          <span class={`w-2 h-2 rounded-full ${storeStatus.isOpen ? 'bg-emerald-400' : 'bg-amber-400'}`}></span>
          <span class="text-slate-200">{storeStatus.message}</span>
        </span>
        <span class="hidden md:inline text-slate-600">|</span>
        <span class="hidden md:flex items-center gap-1.5 text-slate-300">
          <Icon name="mapPin" class="w-3.5 h-3.5 text-[#E31B23]" />
          <span>Pelotas: (53) 3228-5826</span>
          <span class="mx-1 text-slate-600">·</span>
          <span>Canguçu: (53) 99905-9179</span>
        </span>
      </div>

      <div class="flex items-center gap-3 ml-auto text-xs">
        <a
          href={`https://wa.me/${COMPANY_INFO.centralWhatsappRaw}?text=${encodeURIComponent('Olá Mat-Tek! Gostaria de informações sobre atendimento e assistência técnica.')}`}
          target="_blank"
          rel="noreferrer"
          class="flex items-center gap-1.5 text-emerald-400 hover:text-emerald-300 transition-colors font-medium"
        >
          <Icon name="messageCircle" class="w-3.5 h-3.5" />
          <span>WhatsApp: (53) 98448-9179</span>
        </a>
      </div>
    </div>
  </div>

  <!-- Main Single-Page Header -->
  <header class="sticky top-0 z-40 bg-white/95 backdrop-blur-md border-b border-slate-200/80 shadow-xs">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 h-20 flex items-center justify-between gap-4">
      
      <!-- Brand Logo -->
      <a
        href="#inicio"
        class="flex items-center text-left focus:outline-none focus-visible:ring-2 focus-visible:ring-[#E31B23] rounded-md transition-opacity hover:opacity-90"
        aria-label="Mat-Tek Página Inicial"
      >
        <img 
          src="/images/logo.webp" 
          alt="Mat-Tek Máquinas e Motores" 
          width="200" 
          height="54" 
          class="h-12 w-auto object-contain"
        />
      </a>

      <!-- Section Navigation Links -->
      <nav class="hidden lg:flex items-center gap-8" aria-label="Navegação Principal">
        {navLinks.map((link) => (
          <a
            href={`#${link.id}`}
            :class={`activeSection === '${link.id}' ? 'text-[#E31B23]' : 'text-slate-700 hover:text-[#E31B23]'`}
            class="text-sm font-semibold tracking-tight transition-colors relative py-1 whitespace-nowrap"
          >
            <span>{link.label}</span>
            <span 
              x-show={`activeSection === '${link.id}'`}
              class="absolute bottom-0 left-0 right-0 h-0.5 bg-[#E31B23] rounded-full"
            ></span>
          </a>
        ))}
      </nav>

      <!-- Primary Action Button: WhatsApp -->
      <div class="flex items-center gap-2 sm:gap-3">
        <a
          href={`https://wa.me/${COMPANY_INFO.centralWhatsappRaw}?text=${encodeURIComponent('Olá! Vim pelo site da Mat-Tek e gostaria de atendimento.')}`}
          target="_blank"
          rel="noreferrer"
          class="inline-flex items-center gap-2 px-4 py-2.5 text-xs font-bold text-white bg-emerald-600 hover:bg-emerald-700 rounded-xl shadow-xs transition-all active:scale-95 whitespace-nowrap"
        >
          <Icon name="messageCircle" class="w-4 h-4" />
          <span>Falar no WhatsApp</span>
        </a>

        <!-- Mobile Menu Toggle (Alpine.js) -->
        <button
          type="button"
          @click="mobileMenuOpen = !mobileMenuOpen"
          class="lg:hidden p-2.5 min-w-[44px] min-h-[44px] flex items-center justify-center text-slate-700 hover:text-slate-950 hover:bg-slate-100 rounded-lg active:scale-95"
          aria-label="Abrir menu de navegação"
        >
          <span x-show="!mobileMenuOpen">
            <Icon name="menu" class="w-6 h-6" />
          </span>
          <span x-show="mobileMenuOpen" x-cloak>
            <Icon name="x" class="w-6 h-6" />
          </span>
        </button>
      </div>
    </div>

    <!-- Mobile Dropdown Menu -->
    <div 
      x-cloak 
      x-show="mobileMenuOpen"
      x-transition:enter="transition ease-out duration-150"
      x-transition:enter-start="opacity-0 -translate-y-2"
      x-transition:enter-end="opacity-100 translate-y-0"
      x-transition:leave="transition ease-in duration-100"
      x-transition:leave-start="opacity-100 translate-y-0"
      x-transition:leave-end="opacity-0 -translate-y-2"
      class="lg:hidden border-t border-slate-200 bg-white px-4 py-4 space-y-2 shadow-xl"
    >
      {navLinks.map((link) => (
        <a
          href={`#${link.id}`}
          @click="mobileMenuOpen = false"
          :class={`activeSection === '${link.id}' ? 'bg-red-50 text-[#E31B23] font-bold' : 'text-slate-700 hover:bg-slate-50'`}
          class="w-full text-left px-4 py-3 rounded-xl text-sm font-semibold transition-colors flex items-center justify-between"
        >
          <span>{link.label}</span>
          <span x-show={`activeSection === '${link.id}'`} class="w-2 h-2 rounded-full bg-[#E31B23]"></span>
        </a>
      ))}

      <div class="pt-3 border-t border-slate-100 flex flex-col gap-2">
        <a
          href={`https://wa.me/${COMPANY_INFO.centralWhatsappRaw}?text=${encodeURIComponent('Olá! Vim pelo site da Mat-Tek e gostaria de atendimento.')}`}
          target="_blank"
          rel="noreferrer"
          class="w-full flex items-center justify-center gap-2 py-3 bg-emerald-600 hover:bg-emerald-700 text-white rounded-xl text-xs font-bold transition-all shadow-xs"
        >
          <Icon name="messageCircle" class="w-4 h-4" />
          <span>Conversar no WhatsApp</span>
        </a>
      </div>
    </div>
  </header>
</div>
