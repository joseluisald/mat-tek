---
import { COMPANY_INFO } from '../data/stores';
import Icon from './Icon.astro';

const tabs = [
  { id: 'inicio', label: 'Início', icon: 'home' },
  { id: 'parceiros', label: 'Marcas', icon: 'shieldCheck' },
  { id: 'servicos', label: 'Serviços', icon: 'wrench' },
  { id: 'unidades', label: 'Lojas', icon: 'mapPin' },
];
---

<nav 
  aria-label="Navegação móvel inferior"
  class="md:hidden fixed bottom-0 left-0 right-0 z-40 bg-white/95 backdrop-blur-md border-t border-slate-200 px-2 py-1 pb-[max(0.35rem,env(safe-area-inset-bottom))] shadow-lg"
>
  <div class="grid grid-cols-5 items-center justify-items-center max-w-md mx-auto">
    {tabs.map((tab) => (
      <a
        href={`#${tab.id}`}
        :class={`activeSection === '${tab.id}' ? 'text-[#E31B23]' : 'text-slate-500 hover:text-slate-800'`}
        class="flex flex-col items-center justify-center w-full min-h-[48px] py-1 rounded-lg transition-all active:scale-95"
      >
        <div class="relative">
          <Icon name={tab.icon} class="w-5 h-5" />
          <span 
            x-show={`activeSection === '${tab.id}'`}
            class="absolute -bottom-1 left-1/2 -translate-x-1/2 w-1.5 h-1.5 bg-[#E31B23] rounded-full"
          ></span>
        </div>
        <span 
          :class={`activeSection === '${tab.id}' ? 'text-[#E31B23] font-bold' : 'text-slate-600 font-semibold'`}
          class="text-[10px] tracking-tight mt-1"
        >
          {tab.label}
        </span>
      </a>
    ))}

    <!-- WhatsApp Direct Tab -->
    <a
      href={`https://wa.me/${COMPANY_INFO.centralWhatsappRaw}?text=${encodeURIComponent('Olá Mat-Tek! Vim pelo site e gostaria de atendimento.')}`}
      target="_blank"
      rel="noreferrer"
      class="flex flex-col items-center justify-center w-full min-h-[48px] py-1 rounded-lg transition-all active:scale-95 text-emerald-600 hover:text-emerald-700"
    >
      <div class="relative">
        <Icon name="messageCircle" class="w-5 h-5 scale-105" />
      </div>
      <span class="text-[10px] tracking-tight mt-1 font-bold text-emerald-700">
        WhatsApp
      </span>
    </a>
  </div>
</nav>
